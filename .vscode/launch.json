{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Практикум: Python-сервер",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/server.py",
      "cwd": "${workspaceFolder}",
      "args": ["--port", "8090"],
      "env": { "PRAKTIKUM_DEBUG": "1", "PYTHONDONTWRITEBYTECODE": "1" },
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
