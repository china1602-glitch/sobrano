{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "СОБРАНО: запустить Python-сервер",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/server.py",
      "args": [
        "--port",
        "8080"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "SOBRANO_DEBUG": "1",
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
